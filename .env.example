# Site. Read from this file by astro.config.mjs via Vite's loadEnv, so it works
# without exporting it. An unset SITE_URL silently ships example.com canonicals.
SITE_URL="https://example.com"

# Content sync (CMS slot). Missing values are not an error: the build falls back
# to the committed snapshot in src/content/. See docs/ARCHITECTURE/CONTENT_SYNC.md
CONTENT_API_URL=""
CONTENT_API_TOKEN=""
CONTENT_SITE_ID=""

# Remote images. Comma-separated hosts the image pipeline may optimize — the
# CMS/asset host, nothing else. A remote src on an unlisted host fails the build.
IMAGE_REMOTE_HOSTS=""

# Contact form. Provider is chosen in src/content/site/<locale>.json; only the
# transport secrets live here.
PUBLIC_CONTACT_ENDPOINT=""
PUBLIC_CONTACT_KEY=""

# Analytics. Off by default.  none | vercel | plausible | umami | ga4
PUBLIC_ANALYTICS_PROVIDER="none"
PUBLIC_ANALYTICS_DOMAIN=""
PUBLIC_ANALYTICS_ID=""
PUBLIC_ANALYTICS_SRC=""
