---
// Single image entry point. Local assets and remote CMS URLs both go through the
// Astro pipeline; only public/ paths fall back to a plain tag (nothing to optimize).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Media } from '../../schemas/primitives';

export interface Props {
  media: Media;
  class?: string;
  sizes?: string;
}

const { media, class: className, sizes } = Astro.props;
const { src, alt, width, height, priority } = media;

// A single-width srcset makes a 375px phone download the full-size image —
// Lighthouse measured 17KiB wasted on a 20KiB hero, and a real client photo is
// ten times that. The ladder is capped at the source so nothing is upscaled.
const LADDER = [400, 640, 828, 1080, 1440, 1920];
const widths = width ? [...new Set([...LADDER.filter((w) => w < width), width])] : LADDER;

const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
const isRemote = typeof src === 'string' && /^https?:\/\//.test(src);
const isPublic = typeof src === 'string' && !isRemote;
---

{
  typeof src !== 'string' ? (
    <Image
      src={src as ImageMetadata}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  ) : isRemote ? (
    <Image
      src={src}
      alt={alt}
      {...(width && height ? { width, height } : { inferSize: true })}
      widths={width ? widths : undefined}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
      data-public-asset={isPublic ? '' : undefined}
    />
  )
}
