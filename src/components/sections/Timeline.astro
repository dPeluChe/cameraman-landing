---
import SectionShell from './SectionShell.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import type { SectionOf } from '../../schemas/sections';

export interface Props {
  section: SectionOf<'timeline'>;
}

const { section } = Astro.props;
---

<SectionShell anchor={section.anchor}>
  <SectionHeader title={section.title} subtitle={section.subtitle} />

  <div class="mx-auto max-w-3xl">
    <div class="relative ml-4 border-s-2 border-border ps-6 sm:ml-6 sm:ps-8 space-y-10">
      {
        section.items.map((item, idx) => (
          <div class="relative group">
            <span class="absolute -start-[35px] sm:-start-[43px] top-0.5 flex size-8 sm:size-10 items-center justify-center rounded-full border border-border bg-surface text-brand shadow-sm">
              {item.icon ? (
                <Icon name={item.icon} size={18} />
              ) : (
                <span class="text-xs font-bold text-fg">{item.step || String(idx + 1).padStart(2, '0')}</span>
              )}
            </span>

            <div class="rounded-xl border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg font-semibold text-fg">{item.title}</h3>
                <div class="flex items-center gap-2">
                  {item.date && <span class="text-xs font-medium text-fg-subtle">{item.date}</span>}
                  {item.tag && (
                    <span class="rounded-full bg-brand-bg px-2.5 py-0.5 text-xs font-semibold text-brand">
                      {item.tag}
                    </span>
                  )}
                </div>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</SectionShell>
