---
import SectionShell from './SectionShell.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import type { SectionOf } from '../../schemas/sections';

export interface Props {
  section: SectionOf<'pricing'>;
}

const { section } = Astro.props;
const hasYearly = Boolean(section.billingToggle && section.plans.some((p) => p.yearlyPrice));
---

<SectionShell anchor={section.anchor}>
  <div data-pricing-container>
    <SectionHeader title={section.title} subtitle={section.subtitle} />

    {
      hasYearly && section.billingToggle && (
        <div class="mb-10 flex items-center justify-center gap-3">
          <div
            role="group"
            aria-label="Billing frequency"
            class="inline-flex rounded-full border border-border bg-surface-muted p-1 text-sm font-medium text-fg-muted"
          >
            <button
              type="button"
              data-billing-btn="monthly"
              class="rounded-full bg-surface px-4 py-1.5 font-semibold text-fg shadow-sm transition-colors aria-pressed:bg-surface aria-pressed:text-fg"
              aria-pressed="true"
            >
              {section.billingToggle.monthlyLabel}
            </button>
            <button
              type="button"
              data-billing-btn="yearly"
              class="rounded-full px-4 py-1.5 text-fg-muted transition-colors hover:text-fg aria-pressed:bg-surface aria-pressed:font-semibold aria-pressed:text-fg aria-pressed:shadow-sm"
              aria-pressed="false"
            >
              {section.billingToggle.yearlyLabel}
            </button>
          </div>
          {section.billingToggle.discountNote && (
            <span class="rounded-full bg-brand-bg px-2.5 py-0.5 text-xs font-semibold text-brand">
              {section.billingToggle.discountNote}
            </span>
          )}
        </div>
      )
    }

    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        section.plans.map((plan) => (
          <li
            class:list={[
              'flex flex-col rounded-xl border bg-surface p-8',
              plan.featured ? 'border-brand shadow-brand' : 'border-border shadow-sm',
            ]}
          >
            <h3 class="text-lg text-fg">{plan.name}</h3>
            {plan.description && <p class="mt-2 text-sm text-fg-muted">{plan.description}</p>}

            {plan.price && (
              <div class="mt-6">
                <p data-price-monthly class="flex items-baseline gap-1">
                  <span class="text-4xl font-bold text-fg">{plan.price}</span>
                  {plan.period && <span class="text-sm text-fg-subtle">/{plan.period}</span>}
                </p>
                {plan.yearlyPrice && (
                  <p data-price-yearly class="hidden flex items-baseline gap-1">
                    <span class="text-4xl font-bold text-fg">{plan.yearlyPrice}</span>
                    {plan.periodYearly && <span class="text-sm text-fg-subtle">/{plan.periodYearly}</span>}
                  </p>
                )}
              </div>
            )}

            <ul class="mt-6 flex-1 space-y-3 text-sm text-fg-muted">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <svg
                    class="mt-0.5 size-4 shrink-0 text-brand"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <Button link={plan.action} class="mt-8" fullWidth />
          </li>
        ))
      }
    </ul>

    {section.note && <p class="mt-8 text-center text-xs text-fg-subtle">{section.note}</p>}
  </div>
</SectionShell>

{
  hasYearly && (
    <script>
      document.querySelectorAll<HTMLElement>('[data-pricing-container]').forEach((root) => {
        const monthlyBtn = root.querySelector<HTMLButtonElement>('[data-billing-btn="monthly"]');
        const yearlyBtn = root.querySelector<HTMLButtonElement>('[data-billing-btn="yearly"]');
        const monthlyPrices = root.querySelectorAll<HTMLElement>('[data-price-monthly]');
        const yearlyPrices = root.querySelectorAll<HTMLElement>('[data-price-yearly]');

        function setBilling(isYearly: boolean) {
          monthlyBtn?.setAttribute('aria-pressed', String(!isYearly));
          yearlyBtn?.setAttribute('aria-pressed', String(isYearly));

          monthlyBtn?.classList.toggle('bg-surface', !isYearly);
          monthlyBtn?.classList.toggle('text-fg', !isYearly);
          monthlyBtn?.classList.toggle('font-semibold', !isYearly);
          monthlyBtn?.classList.toggle('shadow-sm', !isYearly);

          yearlyBtn?.classList.toggle('bg-surface', isYearly);
          yearlyBtn?.classList.toggle('text-fg', isYearly);
          yearlyBtn?.classList.toggle('font-semibold', isYearly);
          yearlyBtn?.classList.toggle('shadow-sm', isYearly);

          monthlyPrices.forEach((el) => el.classList.toggle('hidden', isYearly));
          yearlyPrices.forEach((el) => el.classList.toggle('hidden', !isYearly));
        }

        monthlyBtn?.addEventListener('click', () => setBilling(false));
        yearlyBtn?.addEventListener('click', () => setBilling(true));
      });
    </script>
  )
}

