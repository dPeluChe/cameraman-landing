---
import SectionShell from './SectionShell.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';
import { renderMarkdown } from '../../lib/markdown';
import type { SectionOf } from '../../schemas/sections';

export interface Props {
  section: SectionOf<'richText'>;
}

const { section } = Astro.props;
const html = renderMarkdown(section.body);
const split = section.layout === 'split' && section.media;
---

<SectionShell anchor={section.anchor}>
  <SectionHeader title={section.title} subtitle={section.subtitle} align={split ? 'start' : 'center'} />

  {
    split ? (
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="prose-content" set:html={html} />
        <Picture
          media={section.media!}
          class="w-full rounded-xl border border-border shadow-md"
          sizes="(min-width: 64rem) 38rem, 100vw"
        />
      </div>
    ) : (
      <div class="prose-content mx-auto max-w-3xl" set:html={html} />
    )
  }
</SectionShell>
