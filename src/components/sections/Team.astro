---
import SectionShell from './SectionShell.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import type { SectionOf } from '../../schemas/sections';
import { initialsOf } from '../../lib/format';

export interface Props {
  section: SectionOf<'team'>;
}

const { section } = Astro.props;

---

<SectionShell anchor={section.anchor}>
  <SectionHeader title={section.title} subtitle={section.subtitle} />

  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      section.members.map((member) => (
        <li class="flex flex-col items-center rounded-xl border border-border bg-surface p-6 text-center">
          {member.photo ? (
            <Picture media={member.photo} class="size-24 rounded-full object-cover" sizes="6rem" />
          ) : (
            <span
              class="flex size-24 items-center justify-center rounded-full bg-brand-bg text-2xl font-bold text-brand"
              aria-hidden="true"
            >
              {initialsOf(member.name)}
            </span>
          )}

          <h3 class="mt-5 text-base text-fg">{member.name}</h3>
          <p class="mt-1 text-sm font-medium text-brand">{member.role}</p>
          {member.bio && <p class="mt-3 text-sm leading-relaxed text-fg-muted">{member.bio}</p>}

          {member.links.length > 0 && (
            <ul class="mt-4 flex gap-2">
              {member.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex size-8 items-center justify-center rounded-full border border-border text-fg-subtle transition-colors hover:border-brand hover:text-brand"
                  >
                    <Icon name={link.icon ?? 'link'} size={14} />
                    <span class="sr-only">{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</SectionShell>
