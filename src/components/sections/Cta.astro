---
import SectionShell from './SectionShell.astro';
import Button from '../ui/Button.astro';
import type { SectionOf } from '../../schemas/sections';

export interface Props {
  section: SectionOf<'cta'>;
}

const { section } = Astro.props;
const titleId = `cta-${section.anchor ?? 'main'}`;
---

<SectionShell anchor={section.anchor} labelledBy={titleId}>
  <div
    class="mx-auto flex max-w-4xl flex-col items-center rounded-xl border border-border bg-surface p-10 text-center shadow-md md:p-16"
  >
    <h2 id={titleId} class="text-2xl text-fg md:text-3xl">{section.title}</h2>
    {section.subtitle && <p class="mt-4 max-w-2xl text-base text-fg-muted md:text-lg">{section.subtitle}</p>}

    <div class="mt-8 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
      {section.actions.map((action) => <Button link={action} />)}
    </div>
  </div>
</SectionShell>
