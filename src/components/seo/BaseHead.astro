---
import { getUi, type SiteEntry } from '../../lib/content';
import { pageTitle, robotsContent, siteBase } from '../../lib/seo';
import { htmlLang, localizedPath, type Locale } from '../../lib/i18n';
import type { Alternate } from '../../lib/routes';
import { analyticsScript } from '../../lib/analytics';
import { absoluteUrl } from '../../lib/url.mjs';
import { Font } from 'astro:assets';
import { FONT_VARS } from '../../lib/font-vars.mjs';

export interface Props {
  site: SiteEntry;
  locale: Locale;
  alternates: Alternate[];
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string;
  /** Posts only: when it was first published and last changed. */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  site,
  locale,
  alternates,
  title,
  description,
  ogImage,
  ogType = 'website',
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
} = Astro.props;

const base = siteBase(Astro);
// Same rule the sitemap uses; see src/lib/url.mjs.
const canonicalUrl = canonical ?? absoluteUrl(new URL(base).origin, Astro.url.pathname);
const resolvedTitle = pageTitle(site, title);
const resolvedDescription = description ?? site.seo.defaultDescription;
const ogUrl = new URL(ogImage ?? site.seo.defaultOgImage, base).href;

const showAlternates = alternates.length > 1;

// Per-locale feed, and only where there is something to syndicate. The title has
// to be the feed's own, not the page's, or every page advertises a different name
// for the same feed.
const rssHref = site.routes.updates?.enabled ? localizedPath(locale, '/rss.xml') : null;
const rssTitle = rssHref ? `${site.brand.name} — ${(await getUi(locale)).updatesTitle}` : '';

const analytics = analyticsScript(site.analytics);
const analyticsOrigin = analytics?.src && /^https?:\/\//.test(analytics.src) ? new URL(analytics.src).origin : null;
const { assets } = site;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<meta name="robots" content={robotsContent(site, noindex)} />
{/* A noindex page has no canonical to declare. Site-wide noindex (pre-launch) keeps it: the sitemap does too. */}
{!noindex && <link rel="canonical" href={canonicalUrl} />}

{
  showAlternates && (
    <>
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.tag} href={absoluteUrl(new URL(base).origin, alt.href)} />
      ))}
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(new URL(base).origin, alternates[0]!.href)} />
    </>
  )
}

{FONT_VARS.map((cssVariable) => <Font cssVariable={cssVariable} preload />)}

{
  analyticsOrigin && (
    <>
      <link rel="preconnect" href={analyticsOrigin} crossorigin="" />
      <link rel="dns-prefetch" href={analyticsOrigin} />
    </>
  )
}

{rssHref && <link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />}

<link rel="icon" href={assets.favicon} sizes="32x32" />
{assets.faviconSvg && <link rel="icon" href={assets.faviconSvg} type="image/svg+xml" />}
<link rel="apple-touch-icon" href={assets.appleTouchIcon} />
{assets.faviconSvg && <link rel="mask-icon" href={assets.faviconSvg} color={assets.maskIconColor} />}
<link rel="manifest" href={assets.manifest} />
<meta name="theme-color" content={assets.themeColor} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={assets.themeColorDark} media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={ogType} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogType === 'article' && publishedTime && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />}
<meta property="og:site_name" content={site.brand.name} />
<meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={(!ogImage && site.seo.defaultOgImageAlt) || resolvedTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogUrl} />
{site.seo.twitterHandle && <meta name="twitter:site" content={site.seo.twitterHandle} />}

{Object.entries(site.seo.verification).map(([name, content]) => <meta name={name} content={content} />)}

{
  analytics && (
    <>
      <script is:inline defer={'defer' in analytics.attrs} src={analytics.src} {...analytics.attrs} />
      {analytics.inline && <script is:inline set:html={analytics.inline} />}
    </>
  )
}
