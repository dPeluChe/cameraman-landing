---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getSite, getUi } from '../lib/content';
import { routeHref } from '../lib/routes';
import { defaultLocale } from '../lib/i18n';

const site = await getSite(defaultLocale);
const ui = await getUi(defaultLocale);
---

<BaseLayout locale={defaultLocale} alternates={[]} title="404" description={ui.notFoundBody} noindex>
  <section class="section-y">
    <div class="container-page flex flex-col items-center text-center">
      <p class="text-6xl font-bold text-brand">404</p>
      <h1 class="mt-4 text-2xl text-fg md:text-3xl">{ui.notFoundTitle}</h1>
      <p class="mt-3 max-w-md text-fg-muted">{ui.notFoundBody}</p>

      <div class="mt-8">
        <Button link={{ label: ui.backToHome, href: routeHref(site, defaultLocale, 'index'), variant: 'primary' }} />
      </div>
    </div>
  </section>
</BaseLayout>
