{
  "name": "landings-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloneable blueprint for static Astro landing sites: Zod-typed content collections, brand tokens, full SEO, es/en i18n.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev --port 4433",
    "sync:content": "node --env-file-if-exists=.env scripts/sync-content.mjs",
    "prebuild": "npm run sync:content",
    "build": "astro build",
    "preview": "astro preview --port 4433",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "reset": "node scripts/reset-content.mjs",
    "preset": "node scripts/apply-preset.mjs",
    "preset:saas": "node scripts/apply-preset.mjs saas",
    "preset:services": "node scripts/apply-preset.mjs services",
    "preset:local": "node scripts/apply-preset.mjs local",
    "preset:leadgen": "node scripts/apply-preset.mjs leadgen",
    "init:clone": "node scripts/init-clone.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "carry": "node scripts/carry-owned.mjs",
    "assets": "node scripts/generate-static-assets.mjs",
    "audit": "node scripts/audit-build.mjs",
    "responsive": "node scripts/check-responsive.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:clone": "node scripts/verify-clone.mjs",
    "doctor": "node scripts/doctor-gate.mjs",
    "pre-deploy": "npm run lint && npm run check && npm run build && npm test && npm run audit && npm run doctor"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@iconify-json/lucide": "^1.2.151",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "react-doctor": "^0.9.22",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
